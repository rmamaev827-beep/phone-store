PORT=4000

# Пусто -> встроенный PostgreSQL (PGlite), файлы базы в server/data.
# Чтобы работать с обычным PostgreSQL, создайте базу и укажите строку подключения:
# DATABASE_URL=postgres://postgres:ВАШ_ПАРОЛЬ@localhost:5432/phone_shop
DATABASE_URL=

# Вход в админку (/admin)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Второй администратор (необязательно): оставьте пустым, чтобы отключить
ADMIN2_LOGIN=admin2
ADMIN2_PASSWORD=
JWT_SECRET=

# Адрес магазина для самовывоза
STORE_ADDRESS=

# Онлайн-оплата картой (Элкарт, Visa, Mastercard) через Freedom Pay.
# Пока три значения ниже пусты, работает демо-оплата: деньги не списываются.
# PUBLIC_URL — адрес сайта в интернете (https://...), на него провайдер возвращает покупателя.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
PUBLIC_URL=
# 1 — тестовый режим провайдера
FREEDOMPAY_TEST=1
